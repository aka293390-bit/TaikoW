; Taiko Flow - original browser rhythm game
config_version=5

[application]
config/name="Taiko Flow"
config/description="A browser-native Japanese rhythm game with TJA import."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/template/ui/loading-background.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.035, 0.025, 0.075, 1)

[autoload]
TuningBridge="*res://scripts/manus/preview/tuning_adapter.gd"
ManusFontTheme="*res://autoload/manus_font_theme.gd"
SaveStore="*res://autoload/save_store.gd"
I18n="*res://autoload/i18n.gd"
TuningStore="*res://autoload/tuning_store.gd"
AudioDirector="*res://autoload/audio_director.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.025, 0.075, 1)

[gui]
theme/default_font_multichannel_signed_distance_field=true

[editor]
import/use_multiple_threads=false
